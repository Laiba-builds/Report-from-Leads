{
  "manifest_version": 3,
  "name": "Report from Leads",
  "version": "1.2.5",
  "minimum_chrome_version": "120",
  "description": "Paste job URLs, silently read LinkedIn and job boards in the background, and create editable reports with rate, vendor and job type.",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Report from Leads",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://www.linkedin.com https://*.linkedin.com"
  }
}
